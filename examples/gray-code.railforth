: base
l r s
;

: floor
up
l l l l

s h
at ( binary の部分 )
  h
  at ( graycode の部分 )
    l .
  tl2
    tl1 .
    l l l l
    dn
    . ( 下に降りる )
  r r r r ( 上からくる部分に繋がる )

.
l l l
;

: roof
up
l l l l
s ss h
at ( 一番上のグレイコードの部分 )
  l .
r
tl1 . 
l l l l
dn
;

base  ( 0 )
floor ( 1 )
floor ( 2 )
floor ( 3 )
floor ( 4 )
floor ( 5 )
floor ( 6 )
floor ( 7 )
roof  ( 8 )

